FROM ghcr.io/cross-rs/aarch64-unknown-linux-gnu:edge

# cpal/alsa-sys 需要 arm64 版 alsa 开发库 (pkg-config 找 alsa.pc);
# 本地增量编译有缓存侥幸跳过, CI 全新编译必须显式安装
RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends libasound2-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

COPY assets/lib/librknnrt.so /usr/lib/aarch64-linux-gnu/librknnrt.so
COPY assets/lib/sherpa-onnx-rknn /opt/sherpa-onnx-rknn

ENV SHERPA_ONNX_LIB_DIR=/opt/sherpa-onnx-rknn/lib
